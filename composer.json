{
    "name": "sunrice/cms",
    "description": "An easy to set up and extend CMS for Laravel, built as a package.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cms",
        "laravel",
        "content-management"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.93",
        "inertiajs/inertia-laravel": "^3.5",
        "spatie/laravel-permission": "^8.0",
        "intervention/image": "^4.0",
        "spatie/simple-excel": "^3.10",
        "spatie/laravel-honeypot": "^4.7",
        "spatie/laravel-sitemap": "^8.0",
        "symfony/html-sanitizer": "^7.4"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0"
    },
    "suggest": {
        "spatie/laravel-responsecache": "^8.0 (requires PHP 8.4) \u2014 enables the optional full-page cache (sunrice.cache.full_page)."
    },
    "autoload": {
        "psr-4": {
            "Sunrice\\": "src/",
            "Sunrice\\Database\\Factories\\": "database/factories/",
            "Sunrice\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sunrice\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sunrice\\SunriceServiceProvider"
            ],
            "aliases": {
                "Sunrice": "Sunrice\\Facades\\Sunrice"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
